# Copy to .env.local and fill in. Never commit real values (SC-1).
# Nothing here is needed for slices S0 to S4. These are used from slice S5 on.

# Supabase (slice S5). See docs/supabase-setup.md. The anon (publishable) key is public by
# design; the service role (secret) key is NOT. Accounts stay off until all three are set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Search engines may list the site only when this is 1. Leave empty until launch.
ALLOW_INDEXING=

# Public site URL, used for sitemap, canonical links and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email service (slice S7). Pick after checking free limits and Indian inbox delivery.
EMAIL_API_KEY=
EMAIL_FROM=

# AI features (roadmap generator, course generator, coach, tutor, answer grader). Off until the key and
# the Supabase settings above are set. Put the key in the host's settings (Vercel), never in the repo (SC-1).
ANTHROPIC_API_KEY=
# Monthly spend cap in US dollars across all learners (CO-1). Also set the same limit in the Anthropic Console.
AI_MONTHLY_CAP_USD=20
# true switches every AI feature off at once.
AI_KILL_SWITCH=false
# Optional. Defaults to claude-opus-5-5.
AI_MODEL=
